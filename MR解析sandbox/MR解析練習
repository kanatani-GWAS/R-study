# 曝露(Exposure): BMI
exposure_dat <- extract_instruments(outcomes = 'ieu-a-2')

# 結果(Outcome): 鉄欠乏性貧血 (ieu-b-4912)
outcome_dat <- extract_outcome_data(
  snps = exposure_dat$SNP,
  outcomes = 'ieu-b-4912'
)
# --- 視覚化の実行 ---

# 1. 散布図 (Scatter plot)
# 各SNPの曝露への効果(x軸)と結果への効果(y軸)をプロットし、回帰直線を引きます
p1 <- mr_scatter_plot(res, dat)
ggsave("plot_scatter_anemia.png", p1[[1]], width = 7, height = 5)

# 2. フォレストプロット (Forest plot)
# 各SNPごとの因果効果の推定値を並べて表示します
res_single <- mr_singlesnp(dat)
p2 <- mr_forest_plot(res_single)
ggsave("plot_forest_anemia.png", p2[[1]], width = 7, height = 9)

# 3. リーブワンアウト解析 (Leave-one-out plot)
# 特定の1つのSNPに結果が引きずられていないか（頑健性）を確認します
res_loo <- mr_leaveoneout(dat)
p3 <- mr_leaveoneout_plot(res_loo)
ggsave("plot_loo_anemia.png", p3[[1]], width = 7, height = 9)

